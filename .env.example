# 로컬에서 수집 스크립트를 돌릴 때만 필요합니다.
# 이 파일을 .env로 복사해서 값을 채우세요. .env는 gitignore에 있어 커밋되지 않습니다.
# 사이트 개발(npm run dev)에는 아무것도 필요 없습니다.

# SNS 수집 (npm run sns:collect, npm run ugc:collect)
# console.apify.com → Settings → Integrations
APIFY_TOKEN=

# 고객 게시물 감정 분석 (npm run ugc:collect)
# console.anthropic.com → Settings → API Keys
# 없으면 감정과 주제만 빠지고 정량 지표는 정상 저장됩니다
ANTHROPIC_API_KEY=

# 데이터 백업 (npm run backup)
# Supabase → Project Settings → API → service_role key
SUPABASE_SERVICE_KEY=

# 유튜브 스튜디오 지표 (node scripts/sns/yt-analytics.mjs)
# 발급 절차는 docs/yt-analytics-setup.md
# 채널마다 관리 신분이 달라 토큰을 여러 개 둡니다
YT_OAUTH_CLIENT_ID=
YT_OAUTH_CLIENT_SECRET=
YT_OAUTH_REFRESH_TOKEN=
YT_OAUTH_REFRESH_TOKEN_2=
YT_OAUTH_REFRESH_TOKEN_3=
YT_OAUTH_REFRESH_TOKEN_4=

# RMN 광고 실적 (node scripts/rmn/ga4-collect.mjs)
# Google Cloud 서비스 계정 JSON을 한 줄로 넣습니다
GA4_KEY_JSON=

# 노션 동기화 (node scripts/notion/sync-notion.mjs)
# 절차는 data/supabase-setup.md 11장
NOTION_TOKEN=
NOTION_DB=

# 팀즈 아침 브리핑 (node scripts/notify/daily-brief.mjs)
# Power Automate 워크플로 URL, 절차는 docs/teams-webhook-setup.md
TEAMS_WEBHOOK_URL=
